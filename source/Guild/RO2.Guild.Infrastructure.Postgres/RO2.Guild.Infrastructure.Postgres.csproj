<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plural namespace: a namespace "RO2.Guild" would shadow the type Guild in every RO2.* file (CS0118). -->
    <RootNamespace>RO2.Guilds.Infrastructure.Postgres</RootNamespace>
  </PropertyGroup>

  <!-- PostgreSQL persistence for the Guild bounded context, sibling of the Mongo one (S15). References the shared
       RO2.Persistence.Postgres for PostgresDbContext and the guild table DDL (PostgresSchema). -->
  <ItemGroup>
    <ProjectReference Include="..\RO2.Guild.Domain\RO2.Guild.Domain.csproj" />
    <ProjectReference Include="..\..\Shared\RO2.BuildingBlocks\RO2.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Platform\RO2.Persistence.Postgres\RO2.Persistence.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RO2.Tests" />
  </ItemGroup>

</Project>
