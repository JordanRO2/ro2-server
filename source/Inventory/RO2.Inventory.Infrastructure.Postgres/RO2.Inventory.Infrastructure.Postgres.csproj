<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- PostgreSQL persistence for the Inventory bounded context, sibling of RO2.Inventory.Infrastructure.Mongo.
       References the shared RO2.Persistence.Postgres for PostgresDbContext: inventory data lives in the same
       database as the game data (not db-per-service). -->
  <ItemGroup>
    <ProjectReference Include="..\RO2.Inventory.Domain\RO2.Inventory.Domain.csproj" />
    <ProjectReference Include="..\RO2.Inventory.Application\RO2.Inventory.Application.csproj" />
    <ProjectReference Include="..\..\Platform\RO2.Persistence.Postgres\RO2.Persistence.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RO2.Tests" />
  </ItemGroup>

</Project>
