<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Plural namespace: a namespace "RO2.Character" would shadow the type Character in every RO2.* file (CS0118). -->
    <RootNamespace>RO2.Characters.Domain</RootNamespace>
  </PropertyGroup>

  <!-- Character bounded context: Domain references ONLY RO2.BuildingBlocks + the shared RO2.GameData kernel. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\RO2.BuildingBlocks\RO2.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Shared\RO2.GameData\RO2.GameData.csproj" />
  </ItemGroup>

</Project>
