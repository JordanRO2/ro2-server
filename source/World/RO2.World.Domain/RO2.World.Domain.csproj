<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Plural namespace (RO2.Worlds.Domain) so it cannot shadow a type, as RO2.Combats/RO2.Skills do. -->
    <RootNamespace>RO2.Worlds.Domain</RootNamespace>
  </PropertyGroup>

  <!-- World bounded context: Domain references ONLY RO2.BuildingBlocks + the shared RO2.GameData kernel.
       Seeded here with the foundational ActorGate primitive that Combat (and later Economy/World) build on. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\RO2.BuildingBlocks\RO2.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Shared\RO2.GameData\RO2.GameData.csproj" />
  </ItemGroup>

</Project>
