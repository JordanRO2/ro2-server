<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Plural namespace: a namespace "RO2.Mail" would shadow any future Mail type in every RO2.* file (CS0118). -->
    <RootNamespace>RO2.Mails.Application</RootNamespace>
  </PropertyGroup>

  <!-- Mail bounded context: Application holds the mail use cases. It references its own Domain + the shared GameData kernel +
       BuildingBlocks + the Inventory and Character contexts it talks to (the attachment rows, the recipient lookup) only.
       The wire, the wallet, the live registries and the order of the side effects stay in the Zone host. Never the Zone host. -->
  <ItemGroup>
    <ProjectReference Include="..\RO2.Mail.Domain\RO2.Mail.Domain.csproj" />
    <ProjectReference Include="..\..\Shared\RO2.BuildingBlocks\RO2.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Shared\RO2.GameData\RO2.GameData.csproj" />
    <ProjectReference Include="..\..\Inventory\RO2.Inventory.Domain\RO2.Inventory.Domain.csproj" />
    <ProjectReference Include="..\..\Character\RO2.Character.Domain\RO2.Character.Domain.csproj" />
  </ItemGroup>

</Project>
