<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plural namespace: a namespace "RO2.Collection" would shadow any future Collection type in every RO2.* file (CS0118), as RO2.Mails.Domain / RO2.Quests.Domain avoid. -->
    <RootNamespace>RO2.Collections.Domain</RootNamespace>
  </PropertyGroup>

  <!-- Collection bounded context: Domain references ONLY RO2.BuildingBlocks + the shared RO2.GameData kernel.
       No Mongo, no ProudNet, no host. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\RO2.BuildingBlocks\RO2.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Shared\RO2.GameData\RO2.GameData.csproj" />
  </ItemGroup>

</Project>
