<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RO2.Collections.Infrastructure.Mongo</RootNamespace>
  </PropertyGroup>

  <!-- MongoDB persistence for the Collection bounded context (S4). References the shared RO2.Persistence.Mongo for
       MongoDbContext, so the collections, collection_monster_progress and pet_incubators documents keep going through
       its class maps (IgnoreExtraElements) in the same database as the game data. -->
  <ItemGroup>
    <ProjectReference Include="..\RO2.Collection.Domain\RO2.Collection.Domain.csproj" />
    <ProjectReference Include="..\..\Shared\RO2.BuildingBlocks\RO2.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Platform\RO2.Persistence.Mongo\RO2.Persistence.Mongo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RO2.Tests" />
  </ItemGroup>

</Project>
