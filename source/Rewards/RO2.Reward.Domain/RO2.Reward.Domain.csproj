<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plural namespace: a namespace "RO2.Reward" would shadow any future Reward type in every RO2.* file (CS0118), as RO2.Companions.Domain / RO2.Mails.Domain / RO2.Quests.Domain avoid. -->
    <RootNamespace>RO2.Rewards.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the stored-shape tests reach the entities' internals. -->
    <InternalsVisibleTo Include="RO2.Tests" />
  </ItemGroup>

  <!-- Rewards bounded context: Domain references ONLY RO2.BuildingBlocks + the shared RO2.GameData kernel.
       No Mongo, no ProudNet, no host. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\RO2.BuildingBlocks\RO2.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Shared\RO2.GameData\RO2.GameData.csproj" />
  </ItemGroup>

</Project>
