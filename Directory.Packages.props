<Project>

  <!--
    Central Package Management: every NuGet version for the solution is declared HERE, once.
    Called for by docs/architecture/TARGET_ARCHITECTURE.md section 7.

    Why this file exists. Versions used to be copy-pasted into all 13 .csproj files, and three
    of them floated (BCrypt.Net-Next "*", xunit "2.*", Microsoft.NET.Test.Sdk "17.*"). A floating
    version means the build is not reproducible and can silently start resolving a package with a
    fresh advisory against it — the same class of problem as the CVEs this file was created to fix.
    Every version below is therefore an exact, non-floating, non-prerelease pin.

    Adding a package: add a PackageVersion here, then reference it from the .csproj WITHOUT a
    Version attribute. A Version attribute in a .csproj is an error once ManagePackageVersionsCentrally
    is on, which is what keeps the two from drifting apart again.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Persistence">
    <!--
      MongoDB.Driver 3.1.0 pulled two transitively vulnerable packages and NuGet audit failed the
      build on them (TreatWarningsAsErrors is on solution-wide):
        SharpCompress 0.30.1  moderate  GHSA-6c8g-7p36-r338
        Snappier      1.0.0   high      GHSA-pggp-6c3x-2xmx
      3.9.0 is the first release that bumps both (to SharpCompress 0.48.1 / Snappier 1.3.1);
      3.10.0 is the current stable and is used here. Verified by diffing the .nuspec dependency
      sets of 3.1.0 / 3.5.0 / 3.6.0 / 3.7.0 / 3.8.0 / 3.9.0 / 3.10.0 — 3.6.0 through 3.8.0 still
      carry the vulnerable pair, so this is not a jump that can be shortened.
      Do not downgrade below 3.9.0 without re-checking the audit.
    -->
    <PackageVersion Include="MongoDB.Driver" Version="3.10.0" />
    <!-- PostgreSQL provider (Phase 3). 8.0.6 is the current 8.0 LTS-aligned stable; its net8.0 asset
         loads on the net11 runtime. Pinned, non-floating, like every version in this file. -->
    <PackageVersion Include="Npgsql" Version="8.0.6" />
    <!-- Redis provider (Phase 3, the Zone<->Chat close-range signal bus via Redis Streams). -->
    <PackageVersion Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>

  <ItemGroup Label="Security">
    <!-- Was "*". 4.2.1 is the latest STABLE; the 5.0.0 line is prerelease only. -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.1" />
  </ItemGroup>

  <ItemGroup Label="Hosting and logging">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <!-- Microsoft.Extensions.Logging.Abstractions is part of the .NET 11 shared framework (the SDK prunes it,
         NU1510), so it is not referenced as a package any more. -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <!-- Were "17.*" / "2.*" / "2.*". Note xunit.runner.visualstudio's stable line is now 3.x. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Docker-gated integration tests for the Postgres provider (Phase 3): an ephemeral postgres:16
         container per test run. Pinned, non-floating. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!-- Docker-gated integration tests for the Redis close-range bus: an ephemeral redis container. -->
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
    <!-- Testcontainers -> Docker.DotNet pulls SSH.NET 2024.1.0, which NuGet audit flags high-severity
         (GHSA-mggc-4xg6-vcxf, GHSA-q939-rpr3-3284 / CVE-2026-48798). Both are fixed in 2026.0.0; pinned
         directly from the test project so the vulnerable transitive is overridden rather than NoWarn'd.
         Only the local-Docker transport is used here, not SSH.NET's SCP/SSH paths, so the major bump is
         inert for our use. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
